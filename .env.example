PROJECT_NAME=ai-comment-recommender
MODEL_PATH=models/comment_ranker.joblib
SCALER_PATH=models/scaler.joblib
FEATURE_CONFIG_PATH=models/feature_config.json
YOUTUBE_API_KEY=
YOUTUBE_CATEGORY_REGION=KR
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 댓글 생성 LLM 제공자 -------------------------------------------------
# ollama(기본, 로컬 모델) | openai
LLM_PROVIDER=ollama

# 로컬 LLM (Ollama) 설정. LLM_PROVIDER=ollama 일 때 사용합니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0.9
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT=120
