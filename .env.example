PROJECT_NAME=ai-comment-recommender
MODEL_PATH=models/comment_ranker.joblib
SCALER_PATH=models/scaler.joblib
FEATURE_CONFIG_PATH=models/feature_config.json
YOUTUBE_API_KEY=
YOUTUBE_CATEGORY_REGION=KR

# Preferred provider: used whenever both values are present.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Fallback provider: used only when OpenAI API key/model are not both configured.
# 2026-08-31 default: Gemini 3.7 Flash via the Gemini Interactions API.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta2
LLM_THINKING_LEVEL=medium
