PROJECT_NAME=ai-comment-recommender
MODEL_PATH=models/comment_ranker.joblib
SCALER_PATH=models/scaler.joblib
FEATURE_CONFIG_PATH=models/feature_config.json
YOUTUBE_API_KEY=
YOUTUBE_CATEGORY_REGION=KR

# 연결된 YouTube 계정을 건드리는 endpoint(/youtube/comments, /youtube/oauth/start,
# /youtube/oauth/disconnect) 보호용. 비워두면 loopback(localhost) 요청만 허용하고,
# 값을 설정하면 X-API-Key 헤더가 일치해야 한다. API를 localhost 밖으로 노출한다면
# 반드시 설정해야 한다.
API_AUTH_TOKEN=

# Optional: required only for posting generated comments to YouTube with your account.
# Create a Google OAuth client and keep the token file under ignored data/runtime/.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/youtube/oauth/callback
YOUTUBE_OAUTH_TOKEN_PATH=data/runtime/youtube_oauth_token.json

# Preferred provider: used whenever both values are present.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Fallback provider: used only when OpenAI API key/model are not both configured.
# Default is local Ollama + Qwen3 8B. No LLM API key is required for Ollama.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_THINKING_LEVEL=medium

# To use Gemini instead, set:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-3.7-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta2
